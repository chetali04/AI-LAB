board = [" "] * 9

def show():
    print(f"""
 {board[0]} | {board[1]} | {board[2]}
---+---+---
 {board[3]} | {board[4]} | {board[5]}
---+---+---
 {board[6]} | {board[7]} | {board[8]}
""")

def winner(p):
    wins = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]
    return any(all(board[i] == p for i in w) for w in wins)

player = "X"

for turn in range(9):
    show()
    move = int(input(f"Player {player}, choose a position (1-9): ")) - 1

    if board[move] != " ":
        print("That position is already taken!")
        continue

    board[move] = player

    if winner(player):
        show()
        print(f"Player {player} wins!")
        break

    player = "O" if player == "X" else "X"
else:
    show()
    print("It's a draw!")
