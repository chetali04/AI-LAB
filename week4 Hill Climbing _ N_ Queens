import random

def heuristic(board):
    conflicts = 0
    for i in range(4):
        for j in range(i + 1, 4):
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1
    return conflicts

def hill_climbing():
    board = [random.randint(0, 3) for _ in range(4)]

    while True:
        h = heuristic(board)

        if h == 0:
            return board

        best = board[:]
        best_h = h

        for col in range(4):
            for row in range(4):
                new_board = board[:]
                new_board[col] = row

                if heuristic(new_board) < best_h:
                    best = new_board
                    best_h = heuristic(new_board)

        if best_h >= h:
            return None

        board = best

while True:
    solution = hill_climbing()
    if solution:
        break

print("Solution:")
for row in range(4):
    print(" ".join("Q" if solution[col] == row else "." for col in range(4)))
