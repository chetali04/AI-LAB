from heapq import heappush, heappop

def misplaced(state, goal):
    return sum(1 for i in range(9)
               if state[i] != 0 and state[i] != goal[i])

def astar(start, goal):
    pq = []
    heappush(pq, (misplaced(start, goal), 0, start, [start]))
    visited = set()

    while pq:
        f, g, state, path = heappop(pq)

        if state == goal:
            return path

        if state in visited:
            continue
        visited.add(state)

        zero = state.index(0)
        r, c = divmod(zero, 3)

        for dr, dc in [(1, 0), (-1, 0),
                       (0, 1), (0, -1)]:
            nr, nc = r + dr, c + dc

            if 0 <= nr < 3 and 0 <= nc < 3:
                pos = nr * 3 + nc
                new = list(state)
                new[zero], new[pos] = new[pos], new[zero]
                new = tuple(new)

                if new not in visited:
                    heappush(pq, (g + 1 + misplaced(new, goal),
                                  g + 1, new, path + [new]))

    return None


start = (1, 2, 3, 0, 4, 6, 7, 5, 8)
goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

result = astar(start, goal)

if result:
    for state in result:
        print(state[:3])
        print(state[3:6])
        print(state[6:])
        print()
    print("Number of moves:", len(result) - 1)
else:
    print("Solution not found")

