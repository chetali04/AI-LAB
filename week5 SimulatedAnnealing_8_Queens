
import random
import math

def heuristic(board):
    conflicts = 0
    for i in range(8):
        for j in range(i + 1, 8):
            if abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1
    return conflicts

def simulated_annealing():
    board = list(range(8))
    random.shuffle(board)
    temperature = 10

    while temperature > 0.01:
        h = heuristic(board)

        if h == 0:
            return board

        new_board = board[:]
        i, j = random.sample(range(8), 2)
        new_board[i], new_board[j] = new_board[j], new_board[i]

        new_h = heuristic(new_board)

        if new_h < h or random.random() < math.exp((h - new_h) / temperature):
            board = new_board

        temperature *= 0.995

    return None

solution = None

for _ in range(1000):
    solution = simulated_annealing()
    if solution is not None:
        break

if solution is not None:
    print("Solution found:")
    for row in range(8):
        print(" ".join("Q" if solution[col] == row else "." for col in range(8)))
else:
    print("Try running again.")
